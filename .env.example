# Optional: published Field Notes are loaded from Sanity when both are set.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Resend delivery for the assessment callback form.
RESEND_API_KEY=re_xxxxxxxxx
# onboarding@resend.dev is suitable for the first test to your Resend account email.
# After verifying anu.ltd, replace it with an address on your domain.
ASSESSMENT_FROM_EMAIL="ANU Website <onboarding@resend.dev>"
ASSESSMENT_TO_EMAIL=info@anu.ltd
